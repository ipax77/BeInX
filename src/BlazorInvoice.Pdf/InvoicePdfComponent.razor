@using System.Globalization
@using beinx.shared
@using beinx.shared.Interfaces
@using Microsoft.JSInterop
@implements IAsyncDisposable
@inject IPdfJsInterop pdfJsInterop
@inject IJSRuntime JS

<div>
    @if (!string.IsNullOrEmpty(ObjectUrl))
    {
        <iframe src="@ObjectUrl" width="100%" height="600px" style="border: none;"></iframe>
    }
    @if (!string.IsNullOrEmpty(error))
    {
        <p class="text-danger">@error</p>
    }
</div>

@code {
    [Parameter]
    public BlazorInvoiceDto? Invoice { get; set; }

    public string ObjectUrl { get; set; } = string.Empty;
    string error = string.Empty;
    private long generation;
    private bool disposed;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await CreatePdf();
        }
        await base.OnAfterRenderAsync(firstRender);
    }

    public void Update(BlazorInvoiceDto? invoice)
    {
        if (disposed) return;
        this.Invoice = invoice;
        _ = CreatePdf();
    }

    private async Task CreatePdf()
    {
        if (disposed) return;
        var request = ++generation;
        var invoice = Invoice;
        string? newUrl = null;
        var newError = string.Empty;
        try
        {
            if (invoice is not null)
            {
                newUrl = await pdfJsInterop
                    .CreateInvoicePdf(invoice, CultureInfo.CurrentCulture.TwoLetterISOLanguageName);
            }
        }
        catch (Exception ex)
        {
            newError = ex.Message;
        }

        if (disposed || request != generation)
        {
            await ReleaseUrl(newUrl);
            return;
        }

        var previousUrl = ObjectUrl;
        ObjectUrl = newUrl ?? string.Empty;
        error = newError;
        await InvokeAsync(() =>
        {
            if (!disposed && request == generation) StateHasChanged();
        });
        await ReleaseUrl(previousUrl);
    }

    private async ValueTask ReleaseUrl(string? url)
    {
        if (string.IsNullOrEmpty(url)) return;
        try
        {
            await JS.InvokeVoidAsync("URL.revokeObjectURL", url);
        }
        catch (JSDisconnectedException) { }
        catch (ObjectDisposedException) { }
    }

    public async ValueTask DisposeAsync()
    {
        if (disposed) return;
        disposed = true;
        generation++;
        var previousUrl = ObjectUrl;
        ObjectUrl = string.Empty;
        await ReleaseUrl(previousUrl);
    }
}
